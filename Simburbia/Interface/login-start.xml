<?xml version="1.0" encoding="UTF-8"?>
<!--
  The login window's Start tab, after the owner's mockup (docs/design/login-screen.png): pick a lot
  and play it. It's the window's content, under a title bar the client draws with the Start and
  Join tabs; the window has no close button, and is centred over the loading screen's art.

  The client draws the lots in "lots" itself, one a row, the picked one highlighted: Hudini's lists
  can't be picked from yet. "preview" is kept for a picture of the picked lot. "play" is enabled
  once a lot is picked; "delete" and "new" wait for their own step.
-->
<UIScript version="1">
  <Window width="380" height="200"/>

  <Style name="label" textColor="#E4E8EE" fontSize="14"/>
  <Style name="lots" textColor="#E4E8EE" selectedTextColor="#FFFFFF" backgroundColor="#222222"
         borderColor="#222222" fillColor="#3E6EBE" fontSize="14"/>

  <Region name="preview" x="10" y="10" width="138" height="122"/>
  <Text name="selectLot" x="158" y="8" width="200" height="14" style="label" text="Select Lot:"/>
  <Region name="lots" x="158" y="26" width="212" height="106" style="lots"/>
  <Button name="delete" x="184" y="142" width="66" height="22" text="Delete"/>
  <Button name="new" x="262" y="142" width="66" height="22" text="New"/>
  <Button name="play" x="224" y="172" width="66" height="22" text="Play"/>
</UIScript>
